<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sendViaEmailBtn"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="24dp"
    tools:context=".getInfos">

    <!-- Header Title -->
    <TextView
        android:id="@+id/titleGetInfos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Customer Information"
        android:textColor="#F8FAFC"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/subtitleGetInfos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Please provide your info for the receipt"
        android:textColor="#94A3B8"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleGetInfos" />

    <!-- First Name Input -->
    <EditText
        android:id="@+id/getNameInput"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:background="#1E293B"
        android:ems="10"
        android:hint="First Name"
        android:inputType="textPersonName"
        android:paddingHorizontal="16dp"
        android:textColor="#F8FAFC"
        android:textColorHint="#64748B"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitleGetInfos" />

    <!-- Last Name Input -->
    <EditText
        android:id="@+id/getlastNameInput"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:background="#1E293B"
        android:ems="10"
        android:hint="Last Name"
        android:inputType="textPersonName"
        android:paddingHorizontal="16dp"
        android:textColor="#F8FAFC"
        android:textColorHint="#64748B"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/getNameInput" />

    <!-- Email Input -->
    <EditText
        android:id="@+id/getEMailInput"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:background="#1E293B"
        android:ems="10"
        android:hint="E-mail Address"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="16dp"
        android:textColor="#F8FAFC"
        android:textColorHint="#64748B"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/getlastNameInput" />

    <!-- Confirm Button -->
    <Button
        android:id="@+id/confirmBtn_getInfos_page"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="#059669"
        android:text="Confirm &amp; View Receipt"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/getEMailInput" />

</androidx.constraintlayout.widget.ConstraintLayout>