<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sendViaEmailBtn"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- Floating Grocery Cart Background Element -->
    <ImageView
        android:id="@+id/floatingCart"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_grocery_cart"
        app:tint="#0284C7"
        android:alpha="0.2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="30dp" />

    <!-- Floating Grocery Bag Background Element -->
    <ImageView
        android:id="@+id/floatingBag"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:src="@drawable/ic_grocery_bag"
        app:tint="#1E3A8A"
        android:alpha="0.15"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="80dp"
        android:layout_marginStart="30dp" />

    <!-- Header Title -->

    <!-- Scan Items Action -->

    <TextView
        android:id="@+id/titleMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="224dp"
        android:text="Grocery App"
        android:textColor="#F8FAFC"
        android:textSize="36sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/goToScannerPageBtn"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="48dp"
        android:backgroundTint="#0284C7"
        android:text="Scan items"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleMain" />

    <!-- Add Products Action -->
    <Button
        android:id="@+id/addProductPage"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#1E293B"
        android:text="Add products"
        android:textAllCaps="false"
        android:textColor="#38BDF8"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/goToScannerPageBtn" />

    <!-- Search Product Action -->
    <Button
        android:id="@+id/searchProductBtn"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#1E293B"
        android:text="Search product"
        android:textAllCaps="false"
        android:textColor="#38BDF8"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/addProductPage" />

    <!-- View All Products Action -->
    <Button
        android:id="@+id/goToProductsPageBtn"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#1E293B"
        android:text="View popular products"
        android:textAllCaps="false"
        android:textColor="#38BDF8"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/searchProductBtn" />

</androidx.constraintlayout.widget.ConstraintLayout>